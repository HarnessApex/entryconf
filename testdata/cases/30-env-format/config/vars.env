# SPEC §4 env format: lines are trimmed of surrounding whitespace before
# classification (so indentation, tabs and whitespace-only lines are fine),
# the value is the text after the FIRST "=", trimmed, then unquoted if what
# remains is wrapped in matching single or double quotes. A comment is a line
# that *starts* with "#", so a "#" inside a value is ordinary text.
EC_PLAIN=plain

  # an indented comment
  EC_INDENTED=indented
	EC_TABBED=tabbed
   
EC_TRIMMED=   spaced out   
EC_WS_ONLY=   
EC_SINGLE='single quoted'
EC_DOUBLE="double quoted"
EC_QUOTED_SPACES="  padded  "
  EC_TRIM_THEN_UNQUOTE=   "padded then trimmed"   
EC_HASH=value # not a comment
EC_EQUALS=a=b=c
