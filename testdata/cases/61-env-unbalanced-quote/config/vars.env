# SPEC §4: the value is the text after the first "=", trimmed of surrounding
# whitespace, and *then* "unquoted if wrapped in matching single or double
# quotes". An unbalanced quote is not a wrapping, so it stays ordinary text:
# there is no line continuation, no escape processing, and no error — a stray
# quote is data, and the leading one survives into the value.
EC_RAW="unclosed
EC_TRAILING=unclosed"
EC_MIXED_DOUBLE_FIRST="mixed'
EC_MIXED_SINGLE_FIRST='mixed"

# Quotes that are simply not at the ends are untouched for the same reason.
EC_INNER=say "hi"

# Trimming happens before the wrapping test, so the trailing whitespace here is
# gone by the time the quotes are compared — and the value still is not wrapped.
EC_TRIM_THEN_CHECK=   "unclosed   

# The wrapping test looks at the first and last character, not at balance, so
# this value is unquoted exactly once and keeps its interior quotes.
EC_NESTED="a "b" c"

# Balanced contrasts.
EC_EMPTY_QUOTES=""
EC_CLOSED="closed"
