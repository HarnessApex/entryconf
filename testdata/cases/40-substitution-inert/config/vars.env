# SPEC §6: text produced by substitution is never re-scanned for "$" or
# "@file:" forms. Every value below therefore lands in the tree literally.
# EC_TARGET exists and sub.json exists, so an implementation that re-scanned
# would produce a *different* result rather than an error.
EC_DOLLAR=$EC_TARGET
EC_BRACED=${EC_TARGET}
EC_ESCAPE=$$
EC_INCLUDE=@file:sub.json
EC_MALFORMED=100$
EC_TARGET=must not appear
