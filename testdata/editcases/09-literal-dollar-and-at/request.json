      "pointer": "/home",
      "value": "$EC_HOME"
    },
    {
      "document": "entrypoint.json",
      "op": "set",
      "pointer": "/inc",
      "value": "@file:x.json"
    },
    {
      "document": "entrypoint.json",
      "op": "set",
