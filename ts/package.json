{
  "name": "entryconf",
  "version": "0.2.0",
  "description": "Load a config directory (one entrypoint + *.env + @file: includes + $VAR interpolation) into a single tree. Implements the entryconf spec 0.2.0.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "entryconf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dump": "node src/cli.ts"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
